# Development environment variables
# Copy this file to .dev.vars and fill in your actual keys

# Proxy authentication token
PROXY_AUTH_TOKEN=your-secret-proxy-token-here

# Freemodel API Keys
FREEMODEL_KEY_1=sk-...
FREEMODEL_KEY_2=sk-...

# Example local routes config:
# ROUTES_CONFIG={"gpt-5.5":[{"provider":"freemodel","baseUrl":"https://api.freemodel.dev","model":"gpt-5.5","apiKeys":["FREEMODEL_KEY_1"]}]}
